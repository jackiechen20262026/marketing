<div class="page"><h1><%= lead.important_flag?'★ ':'' %><%= lead.company_name %> · 发信计划</h1><a href="/portal/leads/<%= lead.id %>">客户详情</a> · <a href="/portal/ai-assistant?leadIds=<%= lead.id %>">分析此客户</a>
<form method="post" action="/portal/leads/<%= lead.id %>/important"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input type="hidden" name="flag" value="<%= lead.important_flag?'0':'1' %>"><button><%= lead.important_flag?'取消重要标记':'设为重要客人' %></button></form>
<p>业务时区 Europe/Berlin；夏令时不存在的手动时间须重新选择，秋季重复时间取较早一次。自然月按月末截断，周期落在春季跳时时顺延一小时。</p>
<form method="post" action="/portal/leads/<%= lead.id %>/mailing" style="display:grid;gap:12px;max-width:650px">
<input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input type="hidden" name="version" value="<%= plan?.version||0 %>">
<label><input type="checkbox" name="enabled" value="1" <%= plan?.enabled?'checked':'' %>>启用周期发信</label>
<label>自然月数 <input name="months" type="number" min="1" max="1200" list="months" value="<%= plan?.months||1 %>" required></label><datalist id="months"><% for(const n of [1,2,3,6,12]){ %><option value="<%= n %>"><% } %></datalist>
<label>首次/下一次日期（延期直接修改）<input type="datetime-local" name="next_at" value="<%= nextLocal %>"></label>
<label>提前提醒天数<input type="number" min="0" max="365" name="reminder_days" value="<%= plan?.reminder_days??3 %>"></label>
<label>负责人<select name="owner_id"><option value="">待分配</option><% for(const o of owners){ %><option value="<%= o.id %>" <%= String(plan?.owner_id)===String(o.id)?'selected':'' %>><%= o.name||o.username %></option><% } %></select></label>
<label><input type="checkbox" name="paused" value="1" <%= plan?.paused?'checked':'' %>>暂停（取消勾选恢复）</label><input name="reason" placeholder="修改/延期/暂停/恢复原因" required maxlength="500"><button>保存计划与审计</button></form>
<% if(user.role==='Admin'){ %><form method="post" action="/portal/leads/<%= lead.id %>/early-mailing"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input name="reason" required placeholder="提前发件原因"><button>建立提前发件草稿</button></form><% } %>
<h2>运单与寄出依据</h2><p>只有单号不代表寄出。填写实际时间（Europe/Berlin）和可追溯凭证；不会向圆通下单。</p>
<% for(const s of shipments){ %><section class="card"><h3><%= s.waybill_no||'尚无单号' %><%= s.original_shipment_id?'（补寄）':'' %></h3><p>实际寄出：<%= s.dispatched_at||'未知' %>；物流签收历史记录：<%= s.signed_at||'未知' %>；客户确认：<%= s.confirmed_received_at||'未知' %>；查询：<%= s.query_status||'未核验' %></p>
<form method="post" action="/portal/mailing/shipments/<%= s.id %>/evidence"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><select name="action"><option value="dispatch">确认实际寄出</option><option value="confirm">客户确认收到</option></select><input type="datetime-local" name="at" required><input name="evidence" required placeholder="凭证编号/客户确认记录"><button>保存事实</button></form>
<% if(user.role==='Admin'){ %><form method="post" action="/portal/mailing/shipments/<%= s.id %>/resend"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input name="reason" required placeholder="补寄原因（须先解除明确异常）"><button>建立补寄草稿（不下单）</button></form><% } %>
<form method="post" action="/portal/mailing/shipments/<%= s.id %>/not-received"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input name="reason" required placeholder="客户反馈未收到的记录"><button>登记未收到异常</button></form></section><% } %>
<h2>异常处理</h2><% for(const x of exceptions){ %><section class="card"><p><%= x.kind %> · <%= x.status %> · <%= x.reason %></p><p>负责人：<%= x.owner_id||'待分配' %> · <%= x.note||'' %></p><form method="post" action="/portal/mailing/exceptions/<%= x.id %>/assign"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><select name="owner_id"><option value="">待分配</option><% for(const o of owners){ %><option value="<%= o.id %>" <%= String(x.owner_id)===String(o.id)?'selected':'' %>><%= o.name||o.username %></option><% } %></select><input name="note" required placeholder="处理备注/转派原因"><button>保存负责人和备注</button></form><% if(x.attachment){ %><a href="/portal/mailing/exceptions/<%= x.id %>/attachment">下载凭证</a><% } %><form method="post" enctype="multipart/form-data" action="/portal/mailing/exceptions/<%= x.id %>/attachment"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input type="file" name="attachment" accept=".pdf,.png,.jpg" required><button>添加附件</button></form><% if(x.status==='open'){ %><form method="post" action="/portal/mailing/exceptions/<%= x.id %>/resolve"><input type="hidden" name="_csrf" value="<%= marketingCsrf %>"><input name="condition" required placeholder="解除条件及依据"><% if(user.role==='Admin'){ %><label><input type="checkbox" name="release_reservation" value="1">已核实原单可结束占用，允许补寄/下次发信（不改变物流事实）</label><% } %><textarea name="note" required placeholder="处理备注"></textarea><button>解除异常并审计</button></form><% } %></section><% } %>
<h2>最近修改</h2><% for(const h of history){ %><p><%= h.created_at %> · <%= h.action %> · <%= h.reason||'' %></p><% } %></div>
